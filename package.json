{
  "name": "mosabaga",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "مسابقة - Real-Time Multiplayer Quiz / Buzzer App (React + Vite + Tailwind + Socket.io)",
  "main": "server.js",
  "scripts": {
    "server": "node server.js",
    "dev:server": "node --watch server.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -k -n SERVER,CLIENT -c red,white \"npm:dev:server\" \"npm:dev:client\"",
    "install:all": "npm install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "start": "node server.js",
    "preview": "npm --prefix client run preview"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
